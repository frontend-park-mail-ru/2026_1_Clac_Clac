<div class="task__page-container" id="task-overlay">
  <div class="task__panel" {{#if noAnimation}}style="animation: none;"{{/if}}>
    <div class="task__header-bar">
      <div class="task__header-left">
        <button class="icon-btn task__close-btn" id="btn-back" title="Закрыть">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="task__header-right">
        <button class="btn btn--primary task__save-btn" id="btn-save-task">Сохранить</button>
        <button class="icon-btn task__options-btn" id="btn-task-options">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="5" cy="12" r="2" />
            <circle cx="12" cy="12" r="2" />
            <circle cx="19" cy="12" r="2" />
          </svg>
        </button>
        <button class="icon-btn task__share-btn" id="btn-share" title="Поделиться">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 3h6v6"></path>
            <path d="M10 14L21 3"></path>
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="task__content">
      <div class="task__board-title" id="task-board-name">{{board_name}}</div>

      <div class="task__title-container">
        <input type="text" class="task__title-input" id="task-title-input" value="{{task.title}}"
          placeholder="Заголовок задачи" maxlength="100">
      </div>

      <div class="task__meta-list">
        <div class="task__meta-item relative-wrapper">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span class="task__meta-label">Исп.:</span>
          <button class="task__meta-value-btn" id="task-executor-btn" data-id="{{task.executor_id}}"
            style="display:flex; align-items:center; gap:0.5rem;">
            {{#if task.executor_id}}
            {{#if task.executor_avatar}}
            <img src="{{task.executor_avatar}}" style="width:20px;height:20px;border-radius:50%;object-fit:cover;">
            {{else}}
            <div
              style="width:20px;height:20px;border-radius:50%;background:var(--primary);color:white;display:flex;align-items:center;justify-content:center;font-size:12px;">
              {{task.executor_fallback}}</div>
            {{/if}}
            {{task.executor}}
            {{else}}
            Не назначен
            {{/if}}
          </button>
        </div>

        <div class="task__meta-item">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <input type="date" class="task__meta-date-input" id="task-date-input" value="{{task.raw_date}}">
        </div>

        <div class="task__meta-item">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <input type="time" class="task__meta-time-input" id="task-time-input" value="{{task.raw_time}}">
        </div>
      </div>

      <div class="task__description-section">
        <div class="task__description-box">
          <textarea class="task__description-textarea" id="task-desc-input"
            placeholder="Добавить описание...">{{task.description}}</textarea>
        </div>
      </div>

      <div class="task__subtasks-section">
        <h3 class="task__section-title">Подзадачи</h3>
        <div class="task__subtasks-list">
          {{#each task.subtasks}}
          <div class="task__subtask-row"
            style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; width: 100%;">
            <label class="custom-checkbox task__subtask-item" style="flex:1; display:flex; align-items:center;">
              <input type="checkbox" class="subtask-checkbox" data-id="{{id}}" data-desc="{{description}}" {{#if is_done}}checked{{/if}}>
              <span class="checkmark"></span>
              <input type="text" class="task__subtask-text-input" value="{{description}}" data-id="{{id}}" data-done="{{is_done}}"
                style="background: transparent; border: none; outline: none; width: 100%; margin-left: 10px; font-size: 0.95rem; {{#if is_done}}color: #666; text-decoration: line-through;{{else}}color: #ccc;{{/if}}">
            </label>
            <button class="icon-btn task__subtask-delete-btn" data-id="{{id}}" style="color: #ff5c5c; padding: 4px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
            </button>
          </div>
          {{/each}}
        </div>
        <div class="task__subtask-add mt-05">
          <input type="text" class="task__subtask-input" id="new-subtask-input" placeholder="Добавить подзадачу...">
        </div>
      </div>

      <div class="task__comments-section">
        <h3 class="task__section-title">Комментарии ({{comments.length}})</h3>

        <div class="task__comments-list">
          {{#each comments}}
          <div class="task__comment" data-id="{{comment_link}}">
            {{#if author_avatar}}
            <img src="{{author_avatar}}" alt="Avatar" class="task__comment-avatar"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
            <div class="task__comment-avatar-fallback" style="display:none;">{{author_fallback}}</div>
            {{else}}
            <div class="task__comment-avatar-fallback">{{author_fallback}}</div>
            {{/if}}
            <div class="task__comment-content">
              <span class="task__comment-author">{{author_name}}</span>
              <div class="task__comment-bubble">
                {{text}}
                <span class="task__comment-time">{{created_time}}</span>
              </div>
            </div>
          </div>
          {{/each}}
          {{#if (eq comments.length 0)}}
          <p style="color: #666; font-size: 0.9rem;">Нет комментариев</p>
          {{/if}}
        </div>
      </div>

      <div class="task__comment-input-area">
        <input type="text" class="task__comment-input" placeholder="Комментарий...">
        <button class="icon-btn task__comment-send-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </div>

    </div>
  </div>
</div>

<div id="modal-overlay" class="modal__overlay hidden">
  <div id="modal-delete-task" class="modal hidden">
    <div class="modal__header">
      <h2 class="modal__title">Удалить карточку</h2>
      <button class="modal__close-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <p class="modal__text">Вы уверены, что хотите удалить карточку “<span id="delete-task-name"
        style="font-weight: bold;"></span>”?</p>
    <div class="modal__actions">
      <button class="btn btn--danger" id="btn-confirm-delete-task">Удалить</button>
      <button class="btn btn--cancel modal__close-btn">Отменить</button>
    </div>
  </div>
</div>
